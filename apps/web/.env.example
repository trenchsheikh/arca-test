# Optional for Vercel. Leave NEXT_PUBLIC_WS_URL unset in production.
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
# NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_RH_CHAIN_ID=46630
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Privy — Solana wallet login only. Create an app at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only. Never prefix with NEXT_PUBLIC_.
PRIVY_APP_SECRET=
# Comma-separated Solana addresses allowed into /admin
NEXT_PUBLIC_ADMIN_WALLETS=

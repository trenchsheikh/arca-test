# Example environment variables for @arca/workers

# Redis connection URL (required for BullMQ)
REDIS_URL=redis://localhost:6379

# Buyback keeper frequency in minutes (default: 60)
BUYBACK_FREQUENCY_MINUTES=60

# Database connection (if not inherited from root .env)
# DATABASE_URL=postgresql://user:password@localhost:5432/arca

# Chain RPC URLs
# ROBINHOOD_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Helius webhook secret for Solana indexing
# HELIUS_WEBHOOK_SECRET=your_secret

# Alchemy webhook auth token for EVM indexing
# ALCHEMY_AUTH_TOKEN=your_token

# ── Local development ──────────────────────────────────────────
# Copy to .env for local use. On Vercel, set vars in Project Settings → Environment Variables.

# Database (not required for the current in-memory demo web app)
DATABASE_URL=postgresql://arca:arca@localhost:5432/arca

# Redis (workers / ws — not hosted on Vercel)
REDIS_URL=redis://localhost:6379

# ── Vercel / web (apps/web) ────────────────────────────────────
# Set NEXT_PUBLIC_APP_URL to your production URL after first deploy, e.g.
# https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Leave unset on Vercel (no WebSocket server there). Locally optional:
# NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Auth (demo login is client-side: admin / pass — no server secret required yet)
SIWE_DOMAIN=localhost
ADMIN_SESSION_SECRET=change-me-in-production

# Robinhood Chain (EVM)
NEXT_PUBLIC_RH_CHAIN_ID=46630
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_WS_URL=

# Solana
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Apply wallet stats use HELIUS_API_KEY (preferred) or public Solana mainnet RPC.
# A configured SOLANA_RPC_URL is used only when it is not a devnet URL.
HELIUS_API_KEY=

# Alchemy (Robinhood production)
ALCHEMY_API_KEY=

# Platform
PLATFORM_TOKEN_ADDRESS=
BUYBACK_KEEPER_PRIVATE_KEY=
